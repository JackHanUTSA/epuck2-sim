WorldInfo {
  info [
    "Swarmlab: Dreamer-inspired four-e-puck virtual-body experiment",
    "Capture-enabled version with overhead camera supervisor"
  ]
  title "E-puck2 Dreamer Team x4 Capture"
  basicTimeStep 16
}
Viewpoint {
  orientation 0 0 1 0
  position 0 0 2.2
}
TexturedBackground {
}
TexturedBackgroundLight {
}
RectangleArena {
  floorSize 1.4 1.4
  wallHeight 0.08
}
WoodenBox {
  translation 0.0 0.22 0.025
  rotation 0 0 1 0.3
  size 0.08 0.08 0.05
}
WoodenBox {
  translation -0.22 -0.10 0.025
  rotation 0 0 1 1.05
  name "wooden box(1)"
  size 0.08 0.08 0.05
}
WoodenBox {
  translation 0.24 -0.24 0.025
  rotation 0 0 1 0.7
  name "wooden box(2)"
  size 0.08 0.08 0.05
}
DEF epuck2_A E-puck {
  translation -0.06 0.06 0
  rotation 0 0 1 0
  name "epuck2_A"
  controller "epuck2_dreamer_team_member"
  customData "{}"
  version "2"
}
DEF epuck2_B E-puck {
  translation 0.06 0.06 0
  rotation 0 0 1 0
  name "epuck2_B"
  controller "epuck2_dreamer_team_member"
  customData "{}"
  version "2"
}
DEF epuck2_C E-puck {
  translation -0.06 -0.06 0
  rotation 0 0 1 0
  name "epuck2_C"
  controller "epuck2_dreamer_team_member"
  customData "{}"
