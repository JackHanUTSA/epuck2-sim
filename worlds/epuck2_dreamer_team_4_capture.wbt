Robot {
  translation 0 -10 0
  name "dreamer_team_supervisor"
  controller "epuck2_dreamer_team_supervisor"
  supervisor TRUE
}
Robot {
  translation 0 -10 0
  children [
    Camera {
      name "overhead_camera"
      width 1280
      height 720
      fieldOfView 1.2
      near 0.01
      far 20
      antiAliasing TRUE
    }
  ]
  name "swarm_capture_supervisor"
  controller "swarm_capture_supervisor"
  supervisor TRUE
}
